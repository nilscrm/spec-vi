diff --git a/tests/programs/f64_sin.vi b/tests/programs/f64_sin.vi
new file mode 100644
index 00000000..b43b55b5
--- /dev/null
+++ b/tests/programs/f64_sin.vi
@@ -0,0 +1,16 @@
+
+pub fn main(&io: &IO) {
+  let positive_zero = 0.0[F64];
+  let negative_zero = F64::from_bits(0x8000000000000000[N64]);
+  assert positive_zero.sin().to_bits() == 0[N64] else { debug::error("check failed") }
+  assert negative_zero.sin().to_bits() == 0x8000000000000000[N64] else {
+    debug::error("check failed")
+  }
+  assert F64::pi.to_bits() == 0x400921fb54442d18[N64] else { debug::error("check failed") }
+  assert (F64::pi / 2.0[F64]).sin() == 1.0[F64] else { debug::error("check failed") }
+  let inf_sin = F64::inf.sin();
+  assert inf_sin != inf_sin else { debug::error("check failed") }
+  let nan_sin = F64::nan.sin();
+  assert nan_sin != nan_sin else { debug::error("check failed") }
+  io.println("passed");
+}
