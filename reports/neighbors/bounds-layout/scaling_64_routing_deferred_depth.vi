use #sph::{neighbors,tree};use tree::Tree;
fn ids(t:Tree[neighbors::Point])->N32 {match t{Tree::Empty(){0}Tree::Leaf(p){p.id+1}Tree::Branch(l,r){ids(l)+ids(r)}}}
fn bits(x:F64)->N32 {let N64(a,b)=x.to_bits();a+b}

fn checksum(b:neighbors::Bounds)->N32 {((bits(b.xmin)+bits(b.xmax))+(bits(b.ymin)+bits(b.ymax)))+((bits(b.zmin)+bits(b.zmax))+b.n)}
fn dump(t:Tree[neighbors::Point],&io:&IO){match t{Tree::Empty(){}Tree::Leaf(p){io.println("p {p.id}");}Tree::Branch(l,r){dump(l,&io);dump(r,&io);}}}
fn show(b:neighbors::Bounds,&io:&IO){
let N64(lo,hi)=b.xmin.to_bits();io.println("b {lo} {hi}");let N64(lo,hi)=b.xmax.to_bits();io.println("b {lo} {hi}");let N64(lo,hi)=b.ymin.to_bits();io.println("b {lo} {hi}");let N64(lo,hi)=b.ymax.to_bits();io.println("b {lo} {hi}");let N64(lo,hi)=b.zmin.to_bits();io.println("b {lo} {hi}");let N64(lo,hi)=b.zmax.to_bits();io.println("b {lo} {hi}");io.println("n {b.n}");}
