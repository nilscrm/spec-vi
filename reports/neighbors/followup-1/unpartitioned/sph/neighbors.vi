
use #sph::tree::Tree;

pub type Point = { id: N32, x: F64, y: F64, z: F64 };
pub type Query = { id: N32, x: F64, y: F64, z: F64, radius: F64, period_z: F64 };
pub type Bounds = { n: N32, xmin: F64, xmax: F64, ymin: F64, ymax: F64, zmin: F64, zmax: F64 };
pub enum* Index {
  Empty(),
  Leaf(Point),
  Branch(Bounds, Index, Index),
}

fn min(a: F64, b: F64) -> F64 {
  if a < b {
    a
  } else {
    b
  }
}
fn max(a: F64, b: F64) -> F64 {
  if a > b {
    a
  } else {
    b
  }
}
fn bounds(t: Tree[Point]) -> Bounds {
  match t {
    Tree::Empty() {
      {
        n: 0,
        xmin: 0.0[F64],
        xmax: 0.0[F64],
        ymin: 0.0[F64],
        ymax: 0.0[F64],
        zmin: 0.0[F64],
        zmax: 0.0[F64],
      }
    }
    Tree::Leaf(p) { { n: 1, xmin: p.x, xmax: p.x, ymin: p.y, ymax: p.y, zmin: p.z, zmax: p.z } }
    Tree::Branch(l, r) { merge(bounds(l), bounds(r)) }
  }
}
fn merge(a: Bounds, b: Bounds) -> Bounds {
  if a.n == 0 {
    b
  } else {
    if b.n == 0 {
      a
    } else {
      {
        n: a.n + b.n,
        xmin: min(a.xmin, b.xmin),
        xmax: max(a.xmax, b.xmax),
        ymin: min(a.ymin, b.ymin),
        ymax: max(a.ymax, b.ymax),
        zmin: min(a.zmin, b.zmin),
        zmax: max(a.zmax, b.zmax),
      }
    }
  }
}

fn construct(t: Tree[Point]) -> (Bounds,Index) {
 match t {
  Tree::Empty() { (bounds(Tree::Empty()),Index::Empty()) }
  Tree::Leaf(p) { (bounds(Tree::Leaf(p)),Index::Leaf(p)) }
  Tree::Branch(l,r) {let (a,l)=construct(l);let (b,r)=construct(r);let box=merge(a,b);(box,Index::Branch(box,l,r))}
 }
}
pub fn build(t: Tree[Point]) -> Index {construct(t).1}
fn inside(p: Point,q: Query) -> Bool {
 let dx=q.x-p.x;let dy=q.y-p.y;let dz=q.z-p.z;
 let dxy=dx*dx+dy*dy;let r2=q.radius*q.radius;
 let local=(dxy+dz*dz < r2);
 let a=q.z-q.period_z-p.z;let b=q.z+q.period_z-p.z;
 (p.id != q.id) & (local | ((q.period_z > 0.0[F64]) & ((dxy+a*a < r2) | (dxy+b*b < r2))))
}
fn overlap_z(b: Bounds, z: F64, r: F64) -> Bool {
  z + r >= b.zmin and z - r <= b.zmax
}
fn overlaps(b: Bounds, q: Query) -> Bool {
  q.x + q.radius >= b.xmin
    and q.x - q.radius <= b.xmax
    and q.y + q.radius >= b.ymin
    and q.y - q.radius <= b.ymax
    and (overlap_z(b, q.z, q.radius)
      or (q.period_z > 0.0[F64]
        and (overlap_z(b, q.z - q.period_z, q.radius) or overlap_z(b, q.z + q.period_z, q.radius))
      )
    )
}
pub fn find(index: Index, q: Query) -> Tree[N32] {
  match index {
    Index::Empty() { Tree::Empty() }
    Index::Leaf(p) {
      if inside(p, q) {
        Tree::Leaf(p.id)
      } else {
        Tree::Empty()
      }
    }
    Index::Branch(b, l, r) {
      if overlaps(b, q) {
        Tree::Branch(find(l, q), find(r, q))
      } else {
        Tree::Empty()
      }
    }
  }
}
