use #sph::tree;use tree::Tree;
type Params={a:F64,b:F64};
fn sum(t:Tree[F64])->N32{match t{Tree::Empty(){0}Tree::Leaf(x){let N64(lo,hi)=x.to_bits();lo+hi}Tree::Branch(l,r){sum(l)+sum(r)}}}
fn dump(t:Tree[F64],&io:&IO){match t{Tree::Empty(){}Tree::Leaf(x){let N64(lo,hi)=x.to_bits();io.println("{lo} {hi}");}Tree::Branch(l,r){dump(l,&io);dump(r,&io);}}}
pub fn main(&io:&IO){let p:Params=black_box({a:1.25[F64],b:-0.5[F64]});let xs=black_box(Tree::Branch(Tree::Branch(Tree::Branch(Tree::Branch(Tree::Leaf(0.0[F64]),Tree::Leaf(1.0[F64])),Tree::Branch(Tree::Leaf(2.0[F64]),Tree::Leaf(3.0[F64]))),Tree::Branch(Tree::Branch(Tree::Leaf(4.0[F64]),Tree::Leaf(5.0[F64])),Tree::Branch(Tree::Leaf(6.0[F64]),Tree::Leaf(7.0[F64])))),Tree::Branch(Tree::Branch(Tree::Branch(Tree::Leaf(8.0[F64]),Tree::Leaf(9.0[F64])),Tree::Branch(Tree::Leaf(10.0[F64]),Tree::Leaf(11.0[F64]))),Tree::Branch(Tree::Branch(Tree::Leaf(12.0[F64]),Tree::Leaf(13.0[F64])),Tree::Branch(Tree::Leaf(14.0[F64]),Tree::Leaf(15.0[F64]))))));let ys=tree::map(xs,fn*(x:F64)->F64 {x*p.a+p.b});io.println("{sum(ys)}");}
