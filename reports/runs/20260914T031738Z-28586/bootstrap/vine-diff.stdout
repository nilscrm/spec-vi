diff --git a/ivm/src/runtime/heap.rs b/ivm/src/runtime/heap.rs
index de9c0e28..157bdd85 100644
--- a/ivm/src/runtime/heap.rs
+++ b/ivm/src/runtime/heap.rs
@@ -12,10 +12,14 @@ pub struct Heap(pub(crate) [Node]);
 pub(crate) struct Node(pub AtomicWord, pub AtomicWord);
 
 /// The maximum size of heap to attempt to allocate.
+///
+/// On 64-bit targets this is a virtual-memory reservation; pages are only
+/// committed as touched, and `Heap::new` halves the request until allocation
+/// succeeds, so a large cap is safe on smaller machines.
 pub const HEAP_SIZE_BYTES: usize = if cfg!(miri) {
   1 << 16
 } else if cfg!(target_pointer_width = "64") {
-  1 << 32
+  1 << 36
 } else {
   1 << 30
 };
