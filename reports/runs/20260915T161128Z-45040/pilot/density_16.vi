use #sph::{pilot, tree};
use tree::Tree;
fn dump(tree: Tree[F64], &io: &IO) {
  match tree {
    Tree::Empty() {}
    Tree::Leaf(p) { io.println("{p}"); }
    Tree::Branch(l,r) { dump(l, &io); dump(r, &io); }
  }
}
