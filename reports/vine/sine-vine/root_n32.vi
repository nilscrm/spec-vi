use #sph::{tree,sine};use tree::Tree;
fn dump(t:Tree[F64],&io:&IO){match t{Tree::Empty(){}Tree::Leaf(x){let N64(lo,hi)=x.to_bits();io.println("{lo} {hi}");}Tree::Branch(l,r){dump(l,&io);dump(r,&io);}}}
fn sum(t:Tree[F64])->N32{match t{Tree::Empty(){0}Tree::Leaf(x){let N64(a,b)=x.to_bits();a+b}Tree::Branch(l,r){sum(l)+sum(r)}}}
pub fn main(&io:&IO){let t=black_box(Tree::Branch(Tree::Branch(Tree::Branch(Tree::Branch(Tree::Branch(Tree::Leaf(-1.28000000000000000e+02[F64]),Tree::Leaf(-1.18163671231161175e+02[F64])),Tree::Branch(Tree::Leaf(-1.07599548385450404e+02[F64]),Tree::Leaf(-9.73893722612835830e+01[F64]))),Tree::Branch(Tree::Branch(Tree::Leaf(-8.73028430785560374e+01[F64]),Tree::Leaf(-7.69690200129499260e+01[F64])),Tree::Branch(Tree::Leaf(-6.67588438887831188e+01[F64]),Tree::Leaf(-5.81194640914111744e+01[F64])))),Tree::Branch(Tree::Branch(Tree::Branch(Tree::Leaf(-4.71238898038469074e+01[F64]),Tree::Leaf(-3.78036064462593515e+01[F64])),Tree::Branch(Tree::Leaf(-2.86358909085835194e+01[F64]),Tree::Leaf(-1.89196955285736976e+01[F64]))),Tree::Branch(Tree::Branch(Tree::Leaf(-9.32789228415325056e+00[F64]),Tree::Leaf(-2.22507385850720138e-308[F64])),Tree::Branch(Tree::Leaf(3.27249234748936946e+00[F64]),Tree::Leaf(8.54120502694724948e+00[F64]))))),Tree::Branch(Tree::Branch(Tree::Branch(Tree::Branch(Tree::Leaf(1.39562006782738308e+01[F64]),Tree::Leaf(1.98941566009623330e+01[F64])),Tree::Branch(Tree::Leaf(2.54272655399923906e+01[F64]),Tree::Leaf(3.09250526837745277e+01[F64]))),Tree::Branch(Tree::Branch(Tree::Leaf(3.76991118430775245e+01[F64]),Tree::Leaf(4.47676953136545563e+01[F64])),Tree::Branch(Tree::Leaf(5.18711543180184549e+01[F64]),Tree::Leaf(5.91563399584148613e+01[F64])))),Tree::Branch(Tree::Branch(Tree::Branch(Tree::Leaf(6.59793716017933889e+01[F64]),Tree::Leaf(7.38274273593601578e+01[F64])),Tree::Branch(Tree::Leaf(8.22801299357064977e+01[F64]),Tree::Leaf(9.03207887907065441e+01[F64]))),Tree::Branch(Tree::Branch(Tree::Leaf(9.96683244560239530e+01[F64]),Tree::Leaf(1.08680324864605922e+02[F64])),Tree::Branch(Tree::Leaf(1.18300540625896900e+02[F64]),Tree::Leaf(1.28000000000000000e+02[F64])))))));io.println("{sum(tree::map(t,fn*(x:F64)->F64 {x.sin_bounded()}))}");}
