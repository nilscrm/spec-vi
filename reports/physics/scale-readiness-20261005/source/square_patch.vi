
// Serial upstream square-patch driver. -s is inclusive, as in sqpatch.cpp.
use #sph::{evolution, ordered, physics, tree};
use tree::Tree;
use #root::IO::File;

fn dump(data: Tree[physics::Particle], &file: &File, &io: &IO) {
  match data {
    Tree::Empty() {}
    Tree::Leaf(p) {
      let radius = (p.x * p.x + p.y * p.y + p.z * p.z).sqrt();
      let radial_velocity = (p.vx * p.x + p.vy * p.y + p.vz * p.z) / radius;
      file
        .write_string(
          &io,
          "{
            p.x
          } {
            p.y
          } {
            p.z
          } {
            p.vx
          } {
            p.vy
          } {
            p.vz
          } {
            p.h
          } {
            p.ro
          } {
            p.u
          } {
            p.p
          } {
            p.c
          } {
            p.grad_P_x
          } {
            p.grad_P_y
          } {
            p.grad_P_z
          } {
            radius
          } {
            radial_velocity
          }\n",
        )
        .assume()
      ;
    }
    Tree::Branch(l, r) {
      dump(l, &file, &io);
      dump(r, &file, &io);
    }
  }
}
pub fn main(&io: &IO) {
  let args = io.args();
  let side = 50;
  let last_step = 10;
  let frequency = 0;
  let describe = false;
  while args.pop_front() is Some(option) {
    if option == "--describe" {
      describe = true;
      continue;
    }
    if option == "--help" or option == "-h" {
      io.println("square_patch [-n SIDE] [-s LAST_STEP] [-w FREQUENCY] [--describe]");
      io.println("Defaults: -n 50 -s 10 -w -1. -s 0 executes one update.");
      return;
    }
    if option != "-n" and option != "-s" and option != "-w" {
      io.println("ERROR: unknown square-patch option: {option}");
      return;
    }
    let value;
    match args.pop_front() {
      Some(text) { value = text; }
      None() {
        io.println("ERROR: missing value for {option}");
        return;
      }
    }
    if option == "-w" {
      match I32::parse(value) {
        Some(n) { frequency = if n > +0 { n as N32 } else { 0 }; }
        None() {
          io.println("ERROR: invalid write frequency");
          return;
        }
      }
    } else {
      match N32::parse(value) {
        Some(n) {
          if option == "-n" {
            side = n;
          } else {
            last_step = n;
          }
        }
        None() {
          io.println("ERROR: expected a nonnegative integer for {option}");
          return;
        }
      }
    }
  }
  if side < 10 or side > 1625 or last_step == N32::maximum {
    io.println("ERROR: invalid side or step count");
    return;
  }
  if describe {
    let particles = side * side * side;
    let capacity = ordered::row_capacity(particles);
    let field_bytes = (particles as N64) * 240;
    io.println("profile: unchanged upstream square-patch; SPEC adaptation unverified");
    io.println("particles: {particles}");
    io.println("updates: {last_step + 1}");
    io.println("write_frequency: {frequency}");
    io.println("neighbor_capacity_bound: {capacity}");
    io.println("particle_field_bytes_lower_bound: {field_bytes}");
    io.println("No simulation allocated; tree, neighbor, runtime and temporary memory excluded.");
    return;
  }
  let s = evolution::materialize(evolution::initialize(side));
  let constants = File::create(&io, "constants.txt").assume();
  for iteration in 0..last_step + 1 {
    let (prepared, rows) = evolution::prepare(s);
    s = prepared;
    let neighbors = evolution::neighbor_count(rows);
    s = evolution::materialize(evolution::density(s, rows));
    s = evolution::materialize(evolution::rest(s, iteration));
    s = evolution::materialize(evolution::eos(s));
    s = evolution::materialize(evolution::iad(s, rows));
    s = evolution::materialize(evolution::momentum(s, rows));
    s = evolution::materialize(evolution::timestep(s));
    s = evolution::materialize(evolution::positions(s));
    s = evolution::materialize(evolution::energy(s));
    let dt = physics::at(&s.data, s.n, 0).dt;
    constants
      .write_string(&io, "{iteration} {s.ttot} {dt} {s.etot} {s.ecin} {s.eint} {neighbors}\n")
      .assume()
    ;
    if frequency > 0 and iteration % frequency == 0 {
      let file = File::create(&io, "dump{iteration}.txt").assume();
      dump(s.data, &file, &io);
      file.close(&io);
    }
    io.println("iteration {
      iteration
    }: particles {
      s.n
    }, neighbors {
      neighbors
    }, time {
      s.ttot
    }, energy {
      s.etot
    }");
  }
  constants.close(&io);
}
