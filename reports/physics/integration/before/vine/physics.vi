// Runtime state for the serial square-patch workload; no host physics kernels.
use #sph::{pilot, tree, grid};
use tree::Tree;

pub type Particle = {
  x: F64,
  y: F64,
  z: F64,
  x_m1: F64,
  y_m1: F64,
  z_m1: F64,
  vx: F64,
  vy: F64,
  vz: F64,
  ro: F64,
  ro_0: F64,
  u: F64,
  p: F64,
  p_0: F64,
  h: F64,
  m: F64,
  c: F64,
  grad_P_x: F64,
  grad_P_y: F64,
  grad_P_z: F64,
  du: F64,
  du_m1: F64,
  dt: F64,
  dt_m1: F64,
  c11: F64,
  c12: F64,
  c13: F64,
  c22: F64,
  c23: F64,
  c33: F64,
};

pub fn from_pilot(p: pilot::Particle) -> Particle {
  {x:p.0,y:p.1,z:p.2,x_m1:p.3,y_m1:p.4,z_m1:p.5,vx:p.6,vy:p.7,vz:p.8,ro:p.9,ro_0:p.10,u:p.11,p:p.12,p_0:p.13,h:p.14,m:p.15,c:p.16,grad_P_x:p.17,grad_P_y:p.18,grad_P_z:p.19,du:p.20,du_m1:p.21,dt:p.22,dt_m1:p.23,c11:p.24,c12:p.25,c13:p.26,c22:p.27,c23:p.28,c33:p.29}
}
pub fn to_pilot(p: Particle) -> pilot::Particle {
  (p.x,p.y,p.z,p.x_m1,p.y_m1,p.z_m1,p.vx,p.vy,p.vz,p.ro,p.ro_0,p.u,p.p,p.p_0,p.h,p.m,p.c,p.grad_P_x,p.grad_P_y,p.grad_P_z,p.du,p.du_m1,p.dt,p.dt_m1,p.c11,p.c12,p.c13,p.c22,p.c23,p.c33)
}

pub fn initialize_independent(side: N32, start: N32, count: N32) -> Tree[Particle] {
  if count == 0 { Tree::Empty() } else { if count == 1 {
    Tree::Leaf(from_pilot(pilot::initialize(side,start,true)))
  } else {
    let half=count/2;
    Tree::Branch(initialize_independent(side,start,half),initialize_independent(side,start+half,count-half))
  }}
}

// The initial state is invariant across z except z and z_m1. All cached
// pressure values are computed in Vine with the original pilot reduction.
fn from_plane(&plane: &Tree[Particle], side:N32, start:N32, count:N32)->Tree[Particle] {
  if count==0 {Tree::Empty()} else {if count==1 {
    let p=at(&plane,side*side,start%(side*side));
    let size=side as F64;
    let z=(-0.5[F64]+1.0[F64]/(2.0[F64]*size)+(start/(side*side)) as F64*1.0[F64]/size)*100.0[F64];
    p.z=z;p.z_m1=z;
    Tree::Leaf(p)
  } else {
    let half=count/2;
    Tree::Branch(from_plane(&plane,side,start,half),from_plane(&plane,side,start+half,count-half))
  }}
}
pub fn initialize(side:N32,start:N32,count:N32)->Tree[Particle] {
  let plane=initialize_independent(side,0,side*side);
  from_plane(&plane,side,start,count)
}

// Reference reads are the measured functional baseline. They avoid copying the
// full state into every gather, but serialize access; this is not a depth claim.
pub fn at(&t: &Tree[Particle], n: N32, i: N32) -> Particle {
  match &t {
    &Tree::Empty() { debug::error("empty particle index"); from_pilot(pilot::initialize(12,0,true)) }
    &Tree::Leaf(p) { p }
    &Tree::Branch(l,r) {
      let half=n/2;
      if i<half { at(&l,half,i) } else { at(&r,n-half,i-half) }
    }
  }
}
fn point_at(&t: &Tree[pilot::Point], n: N32, i: N32) -> pilot::Point {
  match &t {
    &Tree::Empty() { debug::error("empty point index"); {x:0.0[F64],y:0.0[F64],z:0.0[F64],m:0.0[F64]} }
    &Tree::Leaf(p) { p }
    &Tree::Branch(l,r) {
      let half=n/2;
      if i<half { point_at(&l,half,i) } else { point_at(&r,n-half,i-half) }
    }
  }
}
fn gather(&points: &Tree[pilot::Point], n: N32, ids: Tree[N32]) -> Tree[pilot::Point] {
  match ids {
    Tree::Empty() { Tree::Empty() }
    Tree::Leaf(i) { Tree::Leaf(point_at(&points,n,i)) }
    Tree::Branch(l,r) { Tree::Branch(gather(&points,n,l),gather(&points,n,r)) }
  }
}

pub fn eos(p: Particle) -> Particle {
  let ratio=p.ro/p.ro_0;
  // Integer exponent is visible Vine arithmetic, not native pow.
  let r2=ratio*ratio;
  let r4=r2*r2;
  let seventh=(r4*r2)*ratio;
  let pressure=(1.0[F64]/7.0[F64])*(3500.0[F64]*3500.0[F64])*(seventh-1.0[F64])+p.p_0;
  p.p=pressure;
  p.c=3500.0[F64];
  p.u=1.0[F64];
  p
}

pub fn density(p: Particle, neighbors: Tree[pilot::Point], period: F64) -> Particle {
  let center={x:p.x,y:p.y,z:p.z,h:p.h,m:p.m,period_z:period};
  p.ro=pilot::density(center,neighbors,true);
  p
}

pub fn rest_density(p: Particle, iteration: N32) -> Particle {
  if iteration==0 { p.ro_0=p.ro; }
  p
}

fn grid_points(t: Tree[Particle], start: N32, count: N32) -> Tree[grid::Point] {
  match t {
    Tree::Empty() {Tree::Empty()}
    Tree::Leaf(p) {Tree::Leaf({id:start,x:p.x,y:p.y,z:p.z})}
    Tree::Branch(l,r) {
      let half=count/2;
      Tree::Branch(grid_points(l,start,half),grid_points(r,start+half,count-half))
    }
  }
}
fn queries(&t: &Tree[Particle], n: N32, start: N32, count: N32, period: F64) -> Tree[(N32,grid::Query)] {
  if count==0 {Tree::Empty()} else { if count==1 {
    let p=at(&t,n,start);
    Tree::Leaf((start,{id:start,x:p.x,y:p.y,z:p.z,radius:2.0[F64]*p.h,period_z:period}))
  } else {
    let half=count/2;
    Tree::Branch(queries(&t,n,start,half,period),queries(&t,n,start+half,count-half,period))
  }}
}
fn z_bounds(t: Tree[Particle]) -> (F64,F64) {
  match t {
    Tree::Empty() {debug::error("empty domain"); (0.0[F64],0.0[F64])}
    Tree::Leaf(p) {(p.z,p.z)}
    Tree::Branch(l,r) {
      let (a,b)=z_bounds(l);let(c,d)=z_bounds(r);
      (if a<c {a}else{c},if b>d {b}else{d})
    }
  }
}

pub fn initial_period(data: Tree[Particle], side: N32) -> F64 {
  let (lo,hi)=z_bounds(data);
  let half=(100.0[F64]/side as F64)/2.0[F64];
  (hi+half)-(lo-half)
}

pub fn neighbor_rows(data: Tree[Particle], n: N32, start: N32, count: N32, period:F64) -> Tree[(N32,Tree[N32])] {
  let index=grid::build(grid_points(data,0,n));
  let requests=queries(&data,n,start,count,period);
  grid::find_batch(index,requests)
}

fn density_rows(&data: &Tree[Particle], &points: &Tree[pilot::Point], n: N32,
  rows: Tree[(N32,Tree[N32])], period:F64, iteration:N32, stage:N32) -> Tree[(N32,Particle)] {
  match rows {
    Tree::Empty() {Tree::Empty()}
    Tree::Leaf((i,ids)) {
      let p=density(at(&data,n,i),gather(&points,n,ids),period);
      let p=if stage>=2 {rest_density(p,iteration)}else{p};
      let p=if stage>=3 {eos(p)}else{p};
      Tree::Leaf((i,p))
    }
    Tree::Branch(l,r) {
      let left=density_rows(&data,&points,n,l,period,iteration,stage);
      // Bound pending gathers: do not dispatch the right query subtree until
      // every result on the left has been evaluated. This costs sequential depth.
      if finite(rows_checksum(left)) {
        Tree::Branch(left,density_rows(&data,&points,n,r,period,iteration,stage))
      } else {debug::error("nonfinite density state");Tree::Empty()}
    }
  }
}

// stage1=density,2=rest density,3=EOS. Every neighbor list is computed in Vine.
pub fn initial_stages(side:N32,start:N32,count:N32,stage:N32) -> Tree[(N32,Particle)] {
  let n=side*side*side;
  let data=initialize(side,0,n);
  let period=initial_period(data,side);
  let rows=neighbor_rows(data,n,start,count,period);
  let points=tree::map(data,fn*(p:Particle)->pilot::Point {{x:p.x,y:p.y,z:p.z,m:p.m}});
  density_rows(&data,&points,n,rows,period,0,stage)
}

pub fn particle_checksum(p:Particle)->F64 {((((p.x + (p.y + p.z)) + ((p.x_m1 + p.y_m1) + (p.z_m1 + p.vx))) + (((p.vy + p.vz) + (p.ro + p.ro_0)) + ((p.u + p.p) + (p.p_0 + p.h)))) + (((p.m + (p.c + p.grad_P_x)) + ((p.grad_P_y + p.grad_P_z) + (p.du + p.du_m1))) + (((p.dt + p.dt_m1) + (p.c11 + p.c12)) + ((p.c13 + p.c22) + (p.c23 + p.c33)))))}
pub fn finite(x:F64)->Bool {x>F64::neg_inf and x<F64::inf}
fn rows_checksum(rows:Tree[(N32,Particle)])->F64 {
 match rows{Tree::Empty(){0.0[F64]}Tree::Leaf((_,p)){particle_checksum(p)}Tree::Branch(l,r){rows_checksum(l)+rows_checksum(r)}}
}
