
use #sph::{tables, tree};
use tree::Tree;

pub type Point = { x: F64, y: F64, z: F64, m: F64 };
pub type Center = { x: F64, y: F64, z: F64, m: F64, h: F64, period_z: F64 };

// Compute20 modes on each axis; retain the exact400-term reduction topology.
type Mode = (F64, F64, F64);
fn axis_modes(x: F64, start: N32, count: N32) -> Tree[Mode] {
  if count == 1 {
    let m = (2 * start + 1) as F64;
    let mp = m * F64::pi;
    Tree::Leaf((m, mp, (mp * (x + 0.5[F64])).sin_bounded()))
  } else {
    let half = count / 2;
    Tree::Branch(axis_modes(x, start, half), axis_modes(x, start + half, count - half))
  }
}
fn mode_at(t: Tree[Mode], i: N32, n: N32) -> Mode {
  match t {
    Tree::Empty() {
      debug::error("invalid mode index");
      (0.0[F64], 0.0[F64], 0.0[F64])
    }
    Tree::Leaf(p) { p }
    Tree::Branch(l, r) {
      let half = n / 2;
      if i < half {
        mode_at(l, i, half)
      } else {
        mode_at(r, i - half, n - half)
      }
    }
  }
}
fn cached_terms(xs: Tree[Mode], ys: Tree[Mode], start: N32, count: N32) -> Tree[F64] {
  if count == 1 {
    let (m, mp, sx) = mode_at(xs, start / 20, 20);
    let (l, lp, sy) = mode_at(ys, start % 20, 20);
    let pi = F64::pi;
    Tree::Leaf(-32.0[F64] * 25.0[F64] / (m * l * (pi * pi)) / (mp * mp + lp * lp) * sx * sy)
  } else {
    let half = count / 2;
    Tree::Branch(cached_terms(xs, ys, start, half), cached_terms(
      xs,
      ys,
      start + half,
      count - half,
    ))
  }
}
fn pressure_terms(x: F64, y: F64, start: N32, count: N32) -> Tree[F64] {
  cached_terms(axis_modes(x, 0, 20), axis_modes(y, 0, 20), start, count)
}

pub type Particle = (
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
  F64,
);

// Field order matches SqPatch::data (including prior-step and IAD fields).
pub fn initialize(side: N32, index: N32, balanced: Bool) -> Particle {
  let size = side as F64;
  let x0 = -0.5[F64]
    + 1.0[F64] / (2.0[F64] * size)
    + ((index / side) % side) as F64 * 1.0[F64] / size
  ;
  let y0 = -0.5[F64] + 1.0[F64] / (2.0[F64] * size) + (index % side) as F64 * 1.0[F64] / size;
  let z0 = -0.5[F64]
    + 1.0[F64] / (2.0[F64] * size)
    + (index / (side * side)) as F64 * 1.0[F64] / size
  ;
  let pressure = tree::reduce(pressure_terms(x0, y0, 0, 400), balanced) * 1000.0[F64] * 10.0[F64];
  let x = x0 * 100.0[F64];
  let y = y0 * 100.0[F64];
  let z = z0 * 100.0[F64];
  let vx = 5.0[F64] * y0 * 100.0[F64];
  let vy = -5.0[F64] * x0 * 100.0[F64];
  let zero = 0.0[F64];
  let dt = 1.0e-6[F64];
  let h = 2.5[F64] * (100.0[F64] / size);
  let mass = 1000000.0[F64] / (side * side * side) as F64;
  (
    x,
    y,
    z,
    x - vx * dt,
    y - vy * dt,
    z,
    vx,
    vy,
    zero,
    1.0[F64],
    1.0[F64],
    zero,
    pressure,
    pressure,
    h,
    mass,
    3500.0[F64],
    zero,
    zero,
    zero,
    zero,
    zero,
    dt,
    dt,
    zero,
    zero,
    zero,
    zero,
    zero,
    zero,
  )
}

fn normalization() -> F64 {
  let n = 6.0[F64];
  2.7012593e-2[F64]
    + 2.0410827e-2[F64] * n.sqrt()
    + 3.7451957e-3[F64] * n
    + 4.7013839e-2[F64] * (n * n * n).sqrt()
}

// The exact upstream table values are generated by reference/generate_tables.cpp.
// Independent static lookups avoid threading a mutable array through queries.
use #root::data::Lookup;
fn harmonic(v: F64) -> F64 {
  let index = (v * 10000.0[F64]) as N32;
  if index >= 20000 {
    0.0[F64]
  } else {
    let entry = tables::harmonic.lookup(index);
    entry.0 + entry.1 * (v - index as F64 / 10000.0[F64])
  }
}

pub fn contribution(center: Center, neighbor: Point) -> F64 {
  let dx = center.x - neighbor.x;
  let dy = center.y - neighbor.y;
  let dz = center.z - neighbor.z;
  let radius = 2.0[F64] * center.h;
  // Preserve the actual computed box extent, including its rounding. Substituting
  // the mathematical 100 cm can change the selected lookup bin at boundaries.
  let dz = if dz > radius {
    dz - center.period_z
  } else {
    if dz < -radius {
      dz + center.period_z
    } else {
      dz
    }
  };
  let distance = (dx * dx + dy * dy + dz * dz).sqrt();
  let w = harmonic(distance / center.h);
  let sixth = w * w * w * w * w * w;
  normalization() * sixth / (center.h * center.h * center.h) * neighbor.m
}

pub fn density(center: Center, neighbors: Tree[Point], balanced: Bool) -> F64 {
  let values = tree::map(neighbors, fn* (neighbor) { contribution(center, neighbor) });
  tree::reduce(values, balanced) + center.m * normalization() / (center.h * center.h * center.h)
}
